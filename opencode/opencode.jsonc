{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "explore": {
      "model": "opencode-go/muse-spark-1.3-contributor#medium",
      "description": "Investigates codebase behavior across files, traces execution paths, and returns evidence without editing code."
    },
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash#max",
      "description": "Handles general tasks that do not fit a specialist role, including mixed investigation and implementation."
    }
  }
}
